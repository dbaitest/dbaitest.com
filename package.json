{
  "name": "dbaitest-site",
  "version": "0.0.0",
  "private": true,
  "description": "dbaitest.com: the hub and per-project documentation for the dbaitest projects, in English and Vietnamese.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "fetch-upstream": "node scripts/fetch-upstream.mjs",
    "predev": "node scripts/fetch-upstream.mjs",
    "dev": "astro dev",
    "precheck": "node scripts/fetch-upstream.mjs",
    "check": "astro check",
    "check:i18n": "node scripts/check-translations.mjs",
    "prebuild": "node scripts/fetch-upstream.mjs",
    "build": "astro build",
    "check:links": "node scripts/check-dist-links.mjs",
    "preview": "astro preview",
    "verify": "npm run check && npm run check:i18n && npm run build && npm run check:links && npm run check:csp",
    "check:csp": "node scripts/check-csp-hashes.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.10",
    "astro": "7.4.7",
    "starlight-links-validator": "0.27.0",
    "starlight-sidebar-topics": "0.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "7.0.2"
  }
}
