---
// Install section: the README's install commands with a copy button, next to the
// once-per-project setup block (the part that removes the containers).
import CodeBlock from '../shared/CodeBlock.astro';
import { dbTestLandingStrings } from '../../i18n/db-test-landing-strings';
import { installCommands, runSetupSample } from '../../lib/upstream-snippets';
import SectionHead from '../shared/SectionHead.astro';
import type { Locale } from '../shared/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dbTestLandingStrings[locale];
---

<section class="section" aria-labelledby="install-title">
  <div class="container">
    <SectionHead id="install-title" kicker={t.installKicker} heading={t.installHeading} />
    <div class="install">
      <div class="install__commands">
        <CodeBlock locale={locale} id="install-commands" code={installCommands} lang="bash" caption="bash" regionLabel={t.installRegion} />
        <p class="install__note">{t.installNote}</p>
      </div>
      <CodeBlock locale={locale} id="run-setup-sample" code={runSetupSample} lang="csharp" caption="TestRun.cs" note={t.runSetupCaption} regionLabel={t.runSetupRegion} />
    </div>
  </div>
</section>

<style>
  .install {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-start;
  }
  .install__commands {
    flex: 3 1 34rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .install > :global(.code-block) {
    flex: 2 1 24rem;
  }
  .install__note {
    font-size: 0.875rem;
    color: var(--landing-faint);
  }
</style>
