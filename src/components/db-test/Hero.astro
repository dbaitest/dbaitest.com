---
// Value proposition, calls to action and the short facts, next to the engine fan-out.
import { dbTestLandingStrings } from '../../i18n/db-test-landing-strings';
import type { Locale } from '../shared/site';
import EngineFanOut from './EngineFanOut.astro';

interface Props {
  locale: Locale;
  ctaHref: string;
  repoUrl: string;
}

const { locale, ctaHref, repoUrl } = Astro.props;
const t = dbTestLandingStrings[locale];
---

<section class="dot-grid" aria-labelledby="hero-title">
  <div class="container hero">
    <div class="hero__copy">
      <p class="pill"><span class="pill__dot" aria-hidden="true"></span>{t.eyebrow}</p>
      <h1 id="hero-title">{t.headingBefore}<span class="accent">{t.headingAccent}</span><br />{t.headingLine2}</h1>
      <p class="hero__lead">{t.lead}</p>
      <div class="hero__actions">
        <a class="button button--primary" href={ctaHref}>
          {t.cta}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a class="button" href={repoUrl}>{t.viewOnGitHub}</a>
      </div>
      <ul class="hero__checks">
        {
          t.checks.map((check) => (
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
              {check}
            </li>
          ))
        }
      </ul>
    </div>
    <EngineFanOut locale={locale} />
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 3.5rem;
    padding-block: clamp(3.5rem, 9vw, 6rem);
  }
  .hero__copy {
    flex: 1.25 1 32rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.625rem;
  }
  h1 {
    font-size: clamp(2.5rem, 4.8vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .hero__lead {
    max-width: 36rem;
    font-size: clamp(1.0625rem, 2.2vw, 1.1875rem);
    color: var(--landing-muted);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__checks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    color: var(--landing-faint);
  }
  .hero__checks li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hero__checks svg {
    color: var(--landing-ok);
  }
</style>
