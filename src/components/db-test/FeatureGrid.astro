---
// "Why": the README's problem → answer table as a grid of numbered cells.
import { dbTestLandingStrings } from '../../i18n/db-test-landing-strings';
import SectionHead from '../shared/SectionHead.astro';
import type { Locale } from '../shared/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dbTestLandingStrings[locale];
---

<section id="why" class="section" aria-labelledby="features-title">
  <div class="container">
    <SectionHead id="features-title" kicker={t.whyKicker} heading={t.featuresHeading} />
    <ol class="features">
      {
        t.features.map((feature, i) => (
          <li class="feature">
            <p class="feature__problem">
              {String(i + 1).padStart(2, '0')} · {feature.problem}
            </p>
            <h3>{feature.title}</h3>
            <p class="feature__body">{feature.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 1.125rem;
    background: var(--sl-color-hairline);
    overflow: hidden;
  }
  .feature {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.75rem;
    background: var(--landing-surface-2);
  }
  .feature__problem {
    font-family: var(--landing-mono);
    font-size: 0.75rem;
    color: var(--landing-faint);
  }
  .feature h3 {
    font-size: 1.25rem;
  }
  .feature__body {
    font-size: 0.9375rem;
    color: var(--landing-muted);
  }
</style>
