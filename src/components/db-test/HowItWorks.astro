---
import { dbTestLandingStrings } from '../../i18n/db-test-landing-strings';
import SectionHead from '../shared/SectionHead.astro';
import type { Locale } from '../shared/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dbTestLandingStrings[locale];
---

<section id="how" class="section" aria-labelledby="steps-title">
  <div class="container">
    <SectionHead id="steps-title" kicker={t.stepsKicker} heading={t.stepsHeading} />
    <ol class="steps">
      {
        t.steps.map((step) => (
          <li class="step">
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .step {
    counter-increment: step;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.625rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 1rem;
    background: var(--landing-surface-2);
  }
  .step::before {
    content: counter(step);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--landing-line-strong);
    border-radius: 0.625rem;
    font-family: var(--landing-mono);
    font-weight: 700;
    color: var(--landing-heading);
  }
  .step:first-child::before {
    border-color: var(--dt-accent-fill);
    background: var(--dt-accent-fill);
    color: var(--dt-on-accent);
  }
  .step h3 {
    font-size: 1.25rem;
  }
  .step p {
    font-size: 0.9375rem;
    color: var(--landing-muted);
  }
</style>
