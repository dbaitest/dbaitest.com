---
// One project on the hub. All data arrives as props: nothing here is project-specific.
interface Props {
  name: string;
  tagline: string;
  tags: string[];
  /** Pinned release of the project, shown as a version chip. */
  release: string;
  releaseLabel: string;
  overviewHref: string;
  overviewLabel: string;
  docsHref: string;
  docsLabel: string;
}

const { name, tagline, tags, release, releaseLabel, overviewHref, overviewLabel, docsHref, docsLabel } = Astro.props;
---

<article class="card">
  <header class="card__head">
    <h3 class="card__name"><a href={overviewHref}>{name}</a></h3>
    <p class="card__release"><span class="card__release-label">{releaseLabel}</span> <code>{release}</code></p>
  </header>
  <p class="card__tagline">{tagline}</p>
  <ul class="card__tags">
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
  <div class="card__actions">
    <a class="button button--primary" href={overviewHref}>{overviewLabel}</a>
    <a class="button button--ghost" href={docsHref}>{docsLabel}</a>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.875rem;
    background: var(--sl-color-bg-surface);
  }
  .card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }
  .card__name {
    font-family: var(--landing-mono);
    font-size: 1.5rem;
  }
  .card__name a {
    color: inherit;
    text-decoration: none;
  }
  .card__release {
    font-size: 0.875rem;
  }
  .card__tagline {
    font-size: 1.0625rem;
  }
  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card__tags li {
    padding: 0.125rem 0.625rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    font-size: 0.8125rem;
  }
  .card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
</style>
