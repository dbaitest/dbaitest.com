---
// Copy-to-clipboard button for the element with id `target`. Hidden until the script finds a
// clipboard API, so no dead control is shown. The button label stays fixed and the visible
// role=status text reports the result, so a screen reader announces it once. The one client
// script on the landing pages besides the engine tabs. Styled for the dark code panels.
interface Props {
  target: string;
  copy: string;
  copied: string;
  failed: string;
}

const { target, copy, copied, failed } = Astro.props;
---

<span class="copy-command">
  <button type="button" class="copy-command__button" hidden data-copy-target={target} data-copied={copied} data-failed={failed}>{copy}</button>
  <span class="copy-command__status" role="status" data-copy-status></span>
</span>

<script>
  const RESET_MS = 2000;
  if (navigator.clipboard) {
    document.querySelectorAll<HTMLButtonElement>('button[data-copy-target]').forEach((button) => {
      const status = button.parentElement?.querySelector('[data-copy-status]');
      button.hidden = false;
      button.addEventListener('click', async () => {
        let label = button.dataset.failed ?? '';
        try {
          const source = document.getElementById(button.dataset.copyTarget ?? '');
          await navigator.clipboard.writeText((source?.textContent ?? '').trim());
          label = button.dataset.copied ?? '';
        } catch {
          // Permission denied or no focus: the failed label tells the reader to copy by hand.
        }
        if (status) status.textContent = label;
        setTimeout(() => {
          if (status) status.textContent = '';
        }, RESET_MS);
      });
    });
  }
</script>

<style>
  .copy-command {
    display: inline-flex;
    align-items: center;
  }
  .copy-command__button:not([hidden]) {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 0.75rem;
    border: 1px solid #2a3040;
    border-radius: 0.5rem;
    background: #161a23;
    color: var(--term-text);
    font: inherit;
    font-family: var(--landing-font);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
  }
  .copy-command__button:hover {
    border-color: var(--dt-accent-fill);
    color: var(--term-bright);
  }
  .copy-command__status {
    margin-inline-start: 0.5rem;
    font-family: var(--landing-font);
    font-size: 0.8125rem;
    color: var(--term-ok);
  }
</style>
