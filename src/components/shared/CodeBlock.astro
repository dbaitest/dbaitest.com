---
// Highlighted code panel (Shiki at build time) with a caption and a copy button. Panels are
// "terminals": dark in both themes, so only Shiki's dark colours are used. The scroll area is
// focusable so keyboard users can scroll long lines.
import { Code } from 'astro:components';
import CopyCommand from './CopyCommand.astro';
import { siteStrings } from '../../i18n/hub-strings';
import type { Locale } from './site';

interface Props {
  locale: Locale;
  id: string;
  code: string;
  lang: 'bash' | 'csharp';
  /** Short caption shown in the panel header, e.g. `bash` or `C#`. */
  caption: string;
  /** Muted text after the caption, e.g. "once per test project". */
  note?: string;
  /** Accessible name of the scrollable code region. */
  regionLabel: string;
}

const { locale, id, code, lang, caption, note, regionLabel } = Astro.props;
const strings = siteStrings[locale];
---

<figure class="term code-block">
  <figcaption class="term__bar">
    <span>{caption}{note && <span class="code-block__note"> · {note}</span>}</span>
    <CopyCommand target={id} copy={strings.copyCode} copied={strings.copied} failed={strings.copyFailed} />
  </figcaption>
  <div class="code-block__scroll" id={id} tabindex="0" role="region" aria-label={regionLabel}>
    <Code code={code} lang={lang} theme="github-dark-high-contrast" />
  </div>
</figure>

<style>
  .code-block {
    display: flex;
    flex-direction: column;
  }
  .code-block__note {
    color: var(--term-dim);
  }
  .code-block__scroll {
    flex: 1;
    overflow: auto;
    max-height: 34rem;
  }
  .code-block__scroll :global(pre.astro-code) {
    margin: 0;
    padding: 1.375rem 1.5rem;
    background: transparent !important;
    font-family: var(--landing-mono);
    font-size: 0.8125rem;
    line-height: 1.75;
    width: max-content;
    min-width: 100%;
  }
</style>
