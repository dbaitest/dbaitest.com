---
// Footer shared by the hub and the landing pages: the mark and note, page-specific links and
// the language switch.
import { siteStrings } from '../../i18n/hub-strings';
import LanguageSwitch from './LanguageSwitch.astro';
import LogoMark from './LogoMark.astro';
import type { Link, Locale } from './site';

interface Props {
  locale: Locale;
  path: string;
  links: Link[];
}

const { locale, path, links } = Astro.props;
const strings = siteStrings[locale];
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <span class="site-footer__name"><LogoMark size={24} />dbaitest</span>
      <p class="site-footer__note">{strings.footerNote}</p>
    </div>
    <nav aria-label={strings.footerLabel}>
      <ul class="site-footer__links">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <LanguageSwitch locale={locale} path={path} />
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--sl-color-hairline);
    background: var(--landing-surface-2);
    padding-block: 2.5rem;
    font-size: 0.9375rem;
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2.5rem;
  }
  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-inline-end: auto;
  }
  .site-footer__name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--landing-heading);
    font-family: var(--landing-display);
    font-size: 1.125rem;
    font-weight: 700;
  }
  .site-footer__note {
    color: var(--landing-faint);
    font-size: 0.875rem;
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer :global(a) {
    color: var(--sl-color-text);
    text-decoration: none;
  }
  .site-footer :global(a:hover) {
    color: var(--landing-heading);
    text-decoration: underline;
  }
</style>
