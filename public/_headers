# Cloudflare Workers static assets: response headers. https://developers.cloudflare.com/workers/static-assets/headers/
# The script/style CSP is a per-page <meta> generated by Astro (hashes differ per page, see
# astro.config.mjs); this header adds the directives a <meta> cannot carry. Browsers enforce both.
# HSTS starts at one day and is raised to a year once the launch checks pass.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  Strict-Transport-Security: max-age=86400

# Fingerprinted build assets never change under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
